# Copy this file to .env and fill in your values. Never commit .env.

# Groq API key — enables cloud inference, vision, and voice (recommended).
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Cloud model used when GROQ_API_KEY is set (default shown below).
# Free-tier options: llama-3.1-8b-instant, openai/gpt-oss-20b
# (llama-3.3-70b-versatile was moved to Groq's enterprise/paid tier — see
# https://console.groq.com/docs/models for the current list)
CLOUD_MODEL=openai/gpt-oss-120b

# Optional: path to a local GGUF model for on-device inference.
# Only required if GROQ_API_KEY is not set. Can also be passed as --model.
MODEL_PATH=
