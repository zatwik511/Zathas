# Copy this file to .env and fill in your values. Never commit .env.
#
# Every variable the server reads is listed here. All of them are optional
# except that you need one way to run inference: a GROQ_API_KEY or a local
# MODEL_PATH.
#
# Model names are checked at startup. If a configured chat model has been
# retired the server refuses to start and prints the models that ARE available,
# rather than failing later on a user's first message.

# ── Cloud provider ────────────────────────────────────────────────────────────

# Groq API key — enables cloud chat, vision, and voice. Free tier available.
# Get one at https://console.groq.com
GROQ_API_KEY=

# Chat model. Free-tier options include openai/gpt-oss-20b and
# llama-3.1-8b-instant. Current list: https://console.groq.com/docs/models
CLOUD_MODEL=openai/gpt-oss-120b

# Model used when an image or scanned PDF is attached. Must be vision-capable.
# If this one is unavailable the server still starts, but image uploads fail.
VISION_MODEL=qwen/qwen3.6-27b

# Speech-to-text model for voice input.
WHISPER_MODEL=whisper-large-v3

# ── Local inference (optional) ────────────────────────────────────────────────

# Path to a GGUF model for on-device inference via llama.cpp. Required only if
# you set no API key at all. Can also be passed as --model.
MODEL_PATH=

# Optional GGUF LoRA adapter applied on top of the local model. A bad path
# warns and falls back to the base model. Can also be passed as --lora.
LORA_PATH=
